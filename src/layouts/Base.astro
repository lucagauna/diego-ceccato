---
/**
 * Shared shell for every page. No client-side JavaScript on purpose:
 * search engines and AI crawlers must find all content in the HTML.
 */
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/600.css";
import "@fontsource/barlow-condensed/700.css";
import "../styles/global.css";
import BarraWhatsApp from "../components/BarraWhatsApp.astro";
import CabeceraPintada from "../components/muestrario/CabeceraPintada.astro";
import PieMuestra from "../components/muestrario/PieMuestra.astro";
import { NOMBRE, type Origen } from "../data/contacto";
import { PREVIEW, ruta } from "../data/sitio";

interface Props {
  titulo: string;
  descripcion: string;
  /** Which service page this is; marks the active link in the header. */
  seccion?: "pintura" | "arreglos";
  /** schema.org object for this page, serialized as JSON-LD. The only <script> the site ships. */
  datos?: Record<string, unknown>;
  /** Origin for the phone-only WhatsApp bar; it pins the main call to action to the bottom of small screens. */
  contacto?: Origen;
}


const { titulo, descripcion, seccion, datos, contacto = "inicio" } = Astro.props;
const etiquetaBarra = seccion ? "Pedí presupuesto" : "Escribime por WhatsApp";
const canonical = new URL(Astro.url.pathname, Astro.site);
// TODO(task 7): og:image with a real photo of Diego once the originals arrive.
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={ruta("/favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={ruta("/favicon-192.png")} type="image/png" sizes="192x192" />
    <link rel="icon" href={ruta("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={ruta("/apple-touch-icon.png")} />
    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {datos && <script is:inline type="application/ld+json" set:html={JSON.stringify(datos)} />}
    <slot name="head" />
  </head>
  <body class="con-barra">
    <a class="saltar" href="#contenido">Ir al contenido</a>

    <CabeceraPintada contacto={contacto} seccion={seccion} />

    <main id="contenido">
      <slot />
    </main>

    <PieMuestra contacto={contacto} />

    <BarraWhatsApp origen={contacto} etiqueta={etiquetaBarra} />
  </body>
</html>
