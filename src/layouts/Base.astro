---
/**
 * Shared shell for every page. No client-side JavaScript on purpose:
 * search engines and AI crawlers must find all content in the HTML.
 */
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";
import BarraWhatsApp from "../components/BarraWhatsApp.astro";
import { HORARIO, NOMBRE, TELEFONO, linkTelefono, type Origen } from "../data/contacto";
import { PREVIEW, ruta } from "../data/sitio";

interface Props {
  titulo: string;
  descripcion: string;
  /** Which business this page belongs to; drives the header links and the theme. */
  seccion?: "hogar" | "bateria";
  /** schema.org object for this page, serialized as JSON-LD. The only <script> the site ships. */
  datos?: Record<string, unknown>;
  /** Origin for the phone-only WhatsApp bar; it pins the main call to action to the bottom of small screens. */
  contacto?: Origen;
}

const { titulo, descripcion, seccion, datos, contacto = "inicio" } = Astro.props;
const etiquetaBarra = seccion === "bateria" ? "Consultá por una clase" : seccion === "hogar" ? "Pedí presupuesto" : "Escribime por WhatsApp";
const oscuro = seccion === "bateria";
const canonical = new URL(Astro.url.pathname, Astro.site);
// TODO(task 7): og:image with a real photo of Diego once the originals arrive.
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={ruta("/favicon.svg")} type="image/svg+xml" />
    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={oscuro ? "#101010" : "#ffffff"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    {datos && <script is:inline type="application/ld+json" set:html={JSON.stringify(datos)} />}
    <slot name="head" />
  </head>
  <body class:list={["con-barra", { "tema-oscuro": oscuro }]}>
    <a class="saltar" href="#contenido">Ir al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a class="cabecera__marca" href={ruta("/")}>{NOMBRE}</a>
        {
          seccion && (
            <nav aria-label="Secciones del sitio">
              <a href={ruta("/pintura/")} aria-current={seccion === "hogar" ? "page" : undefined}>Pintura y arreglos</a>
              <a href={ruta("/clases-de-bateria/")} aria-current={seccion === "bateria" ? "page" : undefined}>Clases de batería</a>
            </nav>
          )
        }
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__filas">
        <p><slot name="pie" /></p>
        <p>
          <a href={linkTelefono()}>{TELEFONO.visible}</a> · {HORARIO}
        </p>
      </div>
    </footer>

    <BarraWhatsApp origen={contacto} etiqueta={etiquetaBarra} />
  </body>
</html>

<style>
  .cabecera {
    border-bottom: 1px solid var(--linea);
  }

  :global(.tema-oscuro) .cabecera {
    border-bottom-color: var(--escenario-linea);
  }

  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .cabecera__marca {
    font-stretch: var(--ancho-titulo);
    font-weight: 700;
    font-size: var(--t-2);
    color: inherit;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: 20px;
    font-size: var(--t-0);
  }

  nav a {
    color: inherit;
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
  }

  nav a[aria-current="page"] {
    border-bottom-color: currentColor;
  }

  .pie {
    border-top: 1px solid var(--linea);
    padding-block: 28px;
    font-size: var(--t-0);
    color: var(--tinta-suave);
  }

  :global(.tema-oscuro) .pie {
    border-top-color: var(--escenario-linea);
    color: var(--tiza-suave);
  }

  .pie__filas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
  }

  .pie__filas p {
    margin: 0;
  }

  .pie a {
    color: inherit;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .cabecera__fila {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding-block: 12px;
      min-height: 0;
    }

    nav {
      gap: 16px;
      font-size: 0.95rem;
    }
  }
</style>
