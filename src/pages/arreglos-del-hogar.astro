---
/**
 * Secondary services: sold to people who already trust Diego for painting.
 * Phone-framed chat hero, the six trades as brass cards, the painting bridge as a
 * blue band, and a brass closing. Only the trades he ticked in the form appear.
 */
import Base from "../layouts/Base.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
import Chat from "../components/Chat.astro";
import Pendiente from "../components/Pendiente.astro";
import { chatArreglos } from "../components/Conversaciones";
import { rubros } from "../data/servicios";
import { HORARIO, TELEFONO, linkTelefono, listarZonas } from "../data/contacto";
import { negocioHogar } from "../data/schema";
import { ruta } from "../data/sitio";

const zonas = listarZonas("y");
---

<Base
  titulo="Arreglos para tu casa en Tigre y Zona Norte · Diego Ceccato"
  descripcion="Plomería, carpintería, herrería, puertas y cerraduras, colocaciones, quinchos y parrillas en Tigre y Zona Norte. 30 años de oficio."
  seccion="arreglos"
  datos={negocioHogar()}
  contacto="arreglos"
>
  <section class="pedido">
    <div class="contenedor pedido__grilla">
      <div>
        <p class="ceja">02 · Naranja</p>
        <h1>Arreglos para tu casa en Tigre y Zona Norte</h1>
        <p class="hero__lead">Si ya me conocés por la pintura, también te resuelvo esto. Arreglos chicos y medianos, de los que no justifican llamar a una empresa.</p>
        <BotonWhatsApp origen="arreglos">Empezar el chat</BotonWhatsApp>
        <dl class="hechos">
          <div><dt>30 años</dt><dd>de oficio</dd></div>
          <div><dt>Trabajo solo</dt><dd>sin intermediarios</dd></div>
          <div><dt>{HORARIO}</dt><dd>horario de atención</dd></div>
          <div><dt>Zona Norte</dt><dd>{zonas}</dd></div>
        </dl>
      </div>
      <Chat mensajes={chatArreglos} marco="telefono" class="pedido__telefono" />
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <p class="ceja">Lo que hago</p>
      <h2>Seis rubros. Mandame una foto y te digo si lo hago y cuánto sale.</h2>
      <div class="tarjetas">
        {rubros.map((r, i) => (
          <div class="tarjeta">
            <span class="tarjeta__num">0{i + 1}</span>
            <h3>{r}</h3>
          </div>
        ))}
      </div>
      <Pendiente texto="Dos o tres ejemplos concretos de cada rubro, con las palabras de Diego. Aire acondicionado y electricidad estaban en su flyer pero no los marcó: a confirmar antes de sumarlos." />
    </div>
  </section>

  <a class="puente" href={ruta("/pintura/")}>
    <div class="contenedor puente__fila">
      <div>
        <p class="puente__ceja">01 · Látex azul</p>
        <h2>Lo que más hago es pintar</h2>
        <p>Interiores, exteriores y frentes, hierro y madera, con reparación de grietas y humedad antes de pintar.</p>
      </div>
      <span class="puente__ir">Ver pintura →</span>
    </div>
  </a>

  <section class="cierre">
    <div class="contenedor cierre__grilla">
      <div>
        <h2>¿Qué hay que arreglar?</h2>
        <p>Mandame una foto por WhatsApp y te digo si lo hago y cuánto sale. O llamá al <a href={linkTelefono()}>{TELEFONO.visible}</a>, {HORARIO.toLowerCase()}.</p>
      </div>
      <div class="cierre__accion">
        <BotonWhatsApp origen="arreglos">Mandar la foto</BotonWhatsApp>
      </div>
    </div>
  </section>
</Base>

<style>
  .ceja { margin: 0 0 10px; font-size: var(--t-0); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--naranja-texto); }

  .pedido { padding-block: clamp(32px, 6vw, 72px) var(--seccion); border-bottom: 1px solid var(--linea); }
  .pedido__grilla { display: grid; gap: 32px 48px; align-items: center; }
  @media (min-width: 820px) { .pedido__grilla { grid-template-columns: 1.2fr 1fr; } }
  .pedido h1 { font-size: var(--t-5); }
  .pedido :global(.pedido__telefono) { justify-self: center; width: 100%; }

  h2 { max-width: 24ch; }

  .tarjetas { display: grid; gap: 12px; grid-template-columns: repeat(2, 1fr); margin-bottom: 16px; }
  @media (min-width: 720px) { .tarjetas { grid-template-columns: repeat(3, 1fr); } }
  .tarjeta { padding: 18px; border-radius: var(--radio); background: var(--naranja); color: var(--tinta-naranja); display: grid; gap: 4px; align-content: end; aspect-ratio: 4 / 3; }
  .tarjeta__num { font-weight: 600; opacity: 0.7; }
  .tarjeta h3 { margin: 0; font-size: var(--t-2); text-transform: uppercase; line-height: 1; }

  .puente { display: block; background: var(--azul); color: #fff; text-decoration: none; padding-block: clamp(28px, 5vw, 48px); transition: filter 150ms ease; }
  .puente:hover { filter: brightness(1.08); }
  .puente__fila { display: grid; gap: 16px 32px; align-items: center; }
  @media (min-width: 720px) { .puente__fila { grid-template-columns: 1fr auto; } }
  .puente__ceja { margin: 0 0 8px; font-size: var(--t-0); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.8; }
  .puente h2 { color: #fff; margin-bottom: 6px; }
  .puente p { margin: 0; opacity: 0.9; }
  .puente__ir { font-weight: 600; font-size: var(--t-1); }

  .cierre { background: var(--naranja); color: var(--tinta-naranja); padding-block: var(--seccion); }
  .cierre__grilla { display: grid; gap: 24px 48px; align-items: center; }
  @media (min-width: 820px) { .cierre__grilla { grid-template-columns: 1.2fr auto; } }
  .cierre h2 { color: inherit; font-size: var(--t-5); }
  .cierre p { margin: 0; }
  .cierre a { color: inherit; font-weight: 600; }
  .cierre :global(.wa--lleno) { box-shadow: 0 0 0 2px rgba(26, 20, 5, 0.25); }
</style>
