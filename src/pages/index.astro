---
/**
 * Home: the fork between the two businesses, as two full-screen doors.
 * The light door previews the painting pages, the dark door previews the drum page.
 * Copy comes from Diego's form answers; nothing here is invented.
 * TODO(task 7): real photos behind each door once his wife sends the originals.
 */
import Base from "../layouts/Base.astro";
import Pendiente from "../components/Pendiente.astro";
import { personaDiego } from "../data/schema";
import { ruta } from "../data/sitio";

const fotoBateria = ruta("/img/diego-bateria-en-vivo.jpg");
---

<Base
  titulo="Diego Ceccato · Pintor en Tigre y Zona Norte · Clases de batería"
  descripcion="Pintura y arreglos para tu casa en Tigre y Zona Norte. Clases de batería a domicilio y online. 30 años de oficio."
  datos={personaDiego()}
  contacto="inicio"
>
  <h1 class="contenedor presentacion">Pintor y baterista en Tigre y Zona Norte</h1>

  <div class="puertas">
    <a class="puerta puerta--clara" href={ruta("/pintura/")}>
      <span class="puerta__cuerpo">
        <span class="puerta__rotulo">Para tu casa</span>
        <h2>Pintura y arreglos</h2>
        <p>Interiores, exteriores y frentes, hierro y madera. También plomería, carpintería, herrería y colocaciones.</p>
        <span class="puerta__dato">30 años de oficio. El que presupuesta y el que hace el trabajo soy yo.</span>
        <span class="puerta__ir">Ver pintura y arreglos</span>
      </span>
      <Pendiente texto="Foto de fondo de esta puerta: un trabajo terminado, en alta resolución." />
    </a>

    <a class="puerta puerta--oscura" href={ruta("/clases-de-bateria/")} style={`--puerta-foto: url("${fotoBateria}")`}>
      <span class="puerta__cuerpo">
        <span class="puerta__rotulo">Para vos</span>
        <h2>Clases de batería</h2>
        <p>Individuales, de una hora. A domicilio en Zona Norte u online desde cualquier lugar.</p>
        <span class="puerta__dato">30 años tocando en vivo, 25 enseñando.</span>
        <span class="puerta__ir">Ver clases</span>
      </span>
      <Pendiente texto="Foto de fondo de esta puerta: la original en alta resolución de Diego tocando." />
    </a>
  </div>


</Base>

<style>
  /* The name is the page heading, but visually a one-line kicker above the doors. */
  .presentacion {
    font-size: var(--t-1);
    font-stretch: var(--ancho-texto);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.4;
    margin-block: 0;
    padding-block: 18px;
    color: var(--tinta-suave);
  }

  /* Two full-screen doors, side by side on wide screens and stacked on phones. */
  .puertas {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 720px) {
    .puertas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .puerta {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    gap: 16px;
    min-height: min(56svh, 520px);
    padding: clamp(28px, 5vw, 56px) clamp(20px, 4vw, 48px);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 150ms ease;
  }

  @media (min-width: 720px) {
    .puerta {
      min-height: min(calc(100svh - 140px), 720px);
    }
  }

  .puerta__cuerpo {
    display: grid;
    gap: 8px;
    max-width: 440px;
  }

  .puerta h2 {
    font-size: var(--t-5);
    margin: 0;
  }

  .puerta p {
    margin: 0;
  }

  .puerta__rotulo {
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .puerta__dato {
    font-weight: 600;
  }

  .puerta__ir {
    margin-top: 10px;
    justify-self: start;
    padding: 12px 20px;
    border-radius: var(--radio);
    font-weight: 600;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .puerta :global(.pendiente) {
    margin: 0;
    font-size: 0.85rem;
  }

  /* Light door: a freshly painted wall. */
  .puerta--clara {
    background: var(--imprimacion);
    color: var(--tinta);
    border-bottom: 1px solid var(--linea);
  }

  .puerta--clara .puerta__rotulo {
    color: var(--azul);
  }

  .puerta--clara .puerta__dato {
    color: var(--tinta-suave);
  }

  .puerta--clara .puerta__ir {
    background: var(--azul);
    color: #fff;
  }

  .puerta--clara:hover {
    background: #e9e7e0;
  }

  /* Dark door: the stage, with the live photo behind, as on the drum page. */
  .puerta--oscura {
    background: var(--escenario);
    color: var(--tiza);
  }

  .puerta--oscura::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--puerta-foto) center 30% / cover no-repeat var(--escenario-2);
    /* The only photo we have is 160px wide: blur it until the original arrives. */
    filter: blur(14px) saturate(0.9);
    transform: scale(1.08);
    transition: transform 400ms ease;
  }

  .puerta--oscura:hover::before {
    transform: scale(1.12);
  }

  .puerta--oscura::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--escenario) 30%, transparent) 0%,
      color-mix(in srgb, var(--escenario) 75%, transparent) 60%,
      var(--escenario) 100%
    );
  }

  .puerta--oscura h2 {
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .puerta--oscura .puerta__rotulo {
    color: var(--laton);
  }

  .puerta--oscura .puerta__dato {
    color: var(--tiza-suave);
  }

  .puerta--oscura .puerta__ir {
    background: var(--laton);
    color: var(--escenario);
  }

  .puerta--oscura :global(.pendiente) {
    background: color-mix(in srgb, var(--escenario-2) 80%, transparent);
    border-color: var(--escenario-linea);
    color: var(--tiza-suave);
  }

  .puerta--oscura :global(.pendiente__rotulo) {
    color: var(--tiza);
  }
</style>
