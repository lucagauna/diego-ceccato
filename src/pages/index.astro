---
/**
 * Home: a paint catalogue page. The name on the left, one paint chip per page on
 * the right. Hovering a chip paints the whole page in that colour (CSS :has(),
 * no script), so the visitor tries the colour on the wall before clicking.
 * Copy comes from Diego's form answers; nothing here is invented.
 */
import Base from "../layouts/Base.astro";
import { muestras } from "../components/Muestras";
import { HORARIO, TELEFONO, linkTelefono } from "../data/contacto";
import { personaDiego } from "../data/schema";
---

<Base
  titulo="Diego Ceccato · Pintor en Tigre y Zona Norte"
  descripcion="Pintura y arreglos para tu casa en Tigre y Zona Norte. 30 años de oficio. Presupuesto por WhatsApp."
  datos={personaDiego()}
  contacto="inicio"
>
  <section class="catalogo">
    <div class="contenedor catalogo__grilla">
      <div class="catalogo__texto">
        <p class="catalogo__ceja">Carta de colores · Tigre y Zona Norte</p>
        <h1>Diego Ceccato</h1>
        <p class="catalogo__sub">Pintor en Tigre y Zona Norte. Pasá el mouse por un color para probarlo en la pared.</p>
        <p class="catalogo__contacto"><a href={linkTelefono()}>{TELEFONO.visible}</a> · {HORARIO}</p>
      </div>

      <nav class="chips" aria-label="Páginas del sitio">
        {muestras.map((m) => (
          <a class={`chip chip--${m.clase}`} href={m.href}>
            <span class="chip__color" aria-hidden="true"></span>
            <span class="chip__cuerpo">
              <span class="chip__codigo">{m.codigo} · {m.tono}</span>
              <span class="chip__nombre">{m.nombre}</span>
              <span class="chip__texto">{m.texto}</span>
            </span>
          </a>
        ))}
      </nav>
    </div>
  </section>
</Base>

<style>
  .catalogo {
    min-height: calc(100svh - 64px);
    display: grid;
    align-items: center;
    background: var(--pared);
    color: var(--tinta);
    transition: background-color 450ms ease, color 450ms ease;
  }

  /* The page tries the colour on. */
  .catalogo:has(.chip--azul:hover) { background: var(--azul); color: #fff; }
  .catalogo:has(.chip--naranja:hover) { background: var(--naranja); color: var(--tinta-naranja); }

  .catalogo:has(.chip:hover) .catalogo__sub,
  .catalogo:has(.chip:hover) .catalogo__contacto,
  .catalogo:has(.chip:hover) .chip__texto,
  .catalogo:has(.chip:hover) .chip__codigo { color: inherit; opacity: 0.85; }

  .catalogo__grilla {
    display: grid;
    gap: 40px;
    padding-block: clamp(32px, 6vw, 72px);
  }

  @media (min-width: 820px) {
    .catalogo__grilla { grid-template-columns: 1.1fr 1fr; align-items: center; }
  }

  .catalogo__ceja {
    margin: 0 0 12px;
    font-size: var(--t-0);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .catalogo h1 {
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.9;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .catalogo__sub { font-size: var(--t-1); max-width: 36ch; margin: 0 0 20px; color: var(--tinta-suave); transition: color 450ms ease; }
  .catalogo__contacto { margin: 0; color: var(--tinta-suave); transition: color 450ms ease; }
  .catalogo__contacto a { font-weight: 600; color: inherit; }

  .chips {
    display: grid;
    gap: 12px;
  }

  .chip {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 16px;
    align-items: center;
    padding: 12px;
    border: 1px solid currentColor;
    border-radius: var(--radio);
    color: inherit;
    text-decoration: none;
    transition: transform 200ms ease, border-color 450ms ease;
  }

  .chip:hover { transform: translateX(6px); }

  .chip__color {
    display: block;
    aspect-ratio: 1;
    border-radius: 3px;
    transition: transform 200ms ease;
  }

  .chip:hover .chip__color { transform: scale(1.08); }

  .chip--azul .chip__color { background: var(--azul); }
  .chip--naranja .chip__color { background: var(--naranja); }

  /* On a painted page the chip of that colour needs an edge to stay visible. */
  .catalogo:has(.chip--azul:hover) .chip--azul .chip__color,
  .catalogo:has(.chip--naranja:hover) .chip--naranja .chip__color { box-shadow: inset 0 0 0 2px currentColor; }

  .chip__cuerpo { display: grid; gap: 2px; }
  .chip__codigo { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--tinta-suave); transition: color 450ms ease; }
  .chip__nombre { font-family: var(--fuente-titulo); font-weight: 700; font-size: var(--t-3); line-height: 1; text-transform: uppercase; }
  .chip__texto { font-size: var(--t-0); color: var(--tinta-suave); transition: color 450ms ease; }
</style>
