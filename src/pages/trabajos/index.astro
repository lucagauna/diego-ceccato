---
/**
 * The jobs Diego publishes himself, newest first. The posts come from the database at build
 * time and are written into the HTML: no JavaScript, like every public page.
 */
import Base from "../../layouts/Base.astro";
import { hayTrabajos, trabajos } from "../../data/publicados";
import { ruta } from "../../data/sitio";
---

<Base
  titulo="Trabajos de pintura y arreglos en Tigre y Zona Norte · Diego Ceccato"
  descripcion="Fotos de trabajos terminados de pintura y arreglos del hogar en Tigre y Zona Norte, del más nuevo al más viejo."
  contacto="trabajos"
>
  {/* An empty section is not for search engines. */}
  {!hayTrabajos && <meta slot="head" name="robots" content="noindex, nofollow" />}

  <section class="seccion">
    <div class="contenedor">
      <h1>Trabajos terminados en Tigre y Zona Norte</h1>
      <p class="obras__lead">Fotos de trabajos de pintura y arreglos, del más nuevo al más viejo.</p>

      {
        hayTrabajos ? (
          <ul class="obras">
            {trabajos.map((trabajo, i) => (
              <li>
                <a class="obra" href={ruta(`/trabajos/${trabajo.slug}/`)}>
                  <img
                    src={ruta(`/img/publicados/${trabajo.fotos[0].archivo}`)}
                    alt=""
                    width={trabajo.fotos[0].ancho}
                    height={trabajo.fotos[0].alto}
                    loading={i < 3 ? "eager" : "lazy"}
                    decoding="async"
                  />
                  <h2>{trabajo.titulo}</h2>
                  <p>
                    {trabajo.fechaLarga}
                    {trabajo.fotos.length > 1 && `, ${trabajo.fotos.length} fotos`}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="suave">Todavía no hay trabajos publicados.</p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .obras__lead {
    max-width: var(--medida);
    margin: 12px 0 0;
    font-size: var(--t-1);
    color: var(--tinta-suave);
  }

  .obras {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 32px 20px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    /* Lists are held to the reading measure site-wide; this one is a grid of photos. */
    max-width: none;
  }

  .obra {
    display: block;
    color: var(--tinta);
    text-decoration: none;
  }

  .obra img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radio);
    background: var(--imprimacion);
  }

  .obra h2 {
    margin: 12px 0 0;
    font-size: var(--t-2);
    line-height: 1.1;
    text-wrap: balance;
  }

  .obra:hover h2 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .obra p {
    margin: 4px 0 0;
    color: var(--tinta-suave);
  }
</style>
