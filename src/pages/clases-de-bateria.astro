---
/**
 * Drum lessons. Different audience, different tone, dark theme.
 * Layout follows a musician's site: a full-bleed photo hero with the name over it,
 * photo tiles as the in-page menu, uppercase headings.
 * Every fact comes from Diego's form answers; open questions are marked with <Pendiente>.
 */
import Base from "../layouts/Base.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
import Pendiente from "../components/Pendiente.astro";
import Cierre from "../components/Cierre.astro";
import { listarZonas } from "../data/contacto";
import { clasesBateria } from "../data/schema";
import { ruta } from "../data/sitio";

const zonas = listarZonas("o");
const foto = ruta("/img/diego-bateria-en-vivo.jpg");

// Spelling of each teacher's name is still to be confirmed by Diego (see Pendiente below).
const profesores = [
  "Jorge Araujo",
  "Pipi Piazzolla",
  "Sebastián Peyceré",
  "Andrés Álvarez",
  "Carlos Riganti",
  "Daniel Volpini",
  "Sebastián Hoyos",
];

// In-page menu, one photo tile per section. Photos pending; see the note under the grid.
const azulejos = [
  { href: "#trayectoria", titulo: "Trayectoria", foto: "Diego en un escenario" },
  { href: "#clases", titulo: "Las clases", foto: "Diego dando una clase" },
  { href: "#preguntas", titulo: "Preguntas", foto: "La batería de cerca" },
  { href: "#contacto", titulo: "Contacto", foto: "Diego con los palillos" },
];
---

<Base
  titulo="Clases de batería a domicilio en Zona Norte y online · Diego Ceccato"
  descripcion="Clases individuales de batería de una hora, a domicilio en Zona Norte u online. 30 años tocando, 25 enseñando. Rock, pop, funk, jazz y blues."
  seccion="bateria"
  datos={clasesBateria()}
  contacto="bateria"
>
  <section class="portada" style={`--portada-foto: url("${foto}")`}>
    <div class="contenedor portada__contenido">
      <p class="portada__nombre" aria-hidden="true">Diego<br />Ceccato</p>
      <h1>Clases de batería a domicilio en Zona Norte y online</h1>
      <p class="hero__lead">
        Aprendé con alguien que toca en vivo desde hace 30 años. Cada clase se arma según lo que tocás y lo que querés aprender.
      </p>
      <p class="suave">Clases individuales de una hora. Para adolescentes desde 15 años y adultos.</p>
      <BotonWhatsApp origen="bateria">Consultá por una clase</BotonWhatsApp>
      <dl class="hechos">
        <div><dt>30 años</dt><dd>tocando</dd></div>
        <div><dt>25 años</dt><dd>enseñando</dd></div>
        <div><dt>1 hora</dt><dd>clase individual</dd></div>
        <div><dt>Desde 15 años</dt><dd>adolescentes y adultos</dd></div>
      </dl>
    </div>
  </section>

  <nav class="seccion azulejos" aria-label="Secciones de esta página">
    <div class="contenedor">
      <ul class="azulejos__grilla">
        {
          azulejos.map((a) => (
            <li>
              <a href={a.href} class="azulejo">
                <span class="azulejo__foto">Foto pendiente: {a.foto}</span>
                <span class="azulejo__titulo">{a.titulo}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <figure class="retrato">
        <Pendiente
          bloque
          texto="La foto de fondo de la portada es la copia chica de 160 píxeles. Faltan el original en alta resolución, una foto por tarjeta y más fotos o videos de shows."
        />
      </figure>
    </div>
  </nav>

  <section class="seccion" id="trayectoria">
    <div class="contenedor dos">
      <div>
        <h2>Trayectoria</h2>
        <p>Hace 30 años que toco en vivo y 25 enseñando. Toqué 12 años con Rinaldo Rafanelli y 3 con Omar Mollo en M.A.M.</p>
      </div>
      <dl class="ficha">
        <div>
          <dt>En vivo</dt>
          <dd>Cosquín Rock, Cemento y Teatro Labardén. Shows en Rosario, Córdoba, Bariloche, Santa Fe, San Luis y Mendoza.</dd>
        </div>
        <div>
          <dt>Estudié con</dt>
          <dd>{profesores.join(", ")}. Con Sebastián Hoyos, tres años de técnica.</dd>
        </div>
      </dl>
    </div>
    <div class="contenedor">
      <Pendiente texto="Confirmar con Diego cómo se escribe cada nombre, en especial Andrés Álvarez." />
    </div>
  </section>

  <section class="seccion" id="clases">
    <div class="contenedor dos">
      <div>
        <h2>Cómo son las clases</h2>
        <p>Una hora, individual. Sin un método fijo: cada alumno es distinto y la clase se arma según lo que toca y lo que quiere aprender.</p>
        <p>Rock, pop, funk, jazz y blues. Nivel intermedio y avanzado.</p>
        <Pendiente texto="¿También principiantes? Diego todavía no contestó." />
      </div>
      <div class="modos">
        <div>
          <h3>A domicilio</h3>
          <p>Voy a tu casa en {zonas}.</p>
        </div>
        <div>
          <h3>Online</h3>
          <p>Por videollamada, desde cualquier lugar del país.</p>
        </div>
        <Pendiente texto="Días y horarios de las clases: a confirmar." />
      </div>
    </div>
  </section>

  <section class="seccion" id="preguntas">
    <div class="contenedor">
      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <div>
          <dt>¿Necesito tener batería para empezar?</dt>
          <dd>No hace falta para arrancar.</dd>
        </div>
        <div>
          <dt>¿Cuánto dura cada clase?</dt>
          <dd>Una hora. Las clases son individuales.</dd>
        </div>
        <div>
          <dt>¿Desde qué edad?</dt>
          <dd>Desde los 15 años. También doy clases a adultos.</dd>
        </div>
        <div>
          <dt>¿Las clases son presenciales?</dt>
          <dd>Pueden ser a domicilio, si vivís en Zona Norte, u online por videollamada.</dd>
        </div>
      </dl>
    </div>
  </section>

  <div id="contacto">
    <Cierre
      titulo="Escribime y coordinamos"
      texto="Contame qué tocás, qué querés aprender y si preferís clases a domicilio u online."
      origen="bateria"
    />
  </div>

  <Fragment slot="pie">
    Diego Ceccato · Clases de batería · Zona Norte y online · <a href={ruta("/pintura/")}>Pintura y arreglos</a>
  </Fragment>
</Base>

<style>
  /* Full-bleed photo hero. The photo sits behind a dark gradient so the text stays readable. */
  .portada {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(88svh, 760px);
    padding-block: clamp(48px, 10vw, 96px) clamp(32px, 6vw, 56px);
    overflow: hidden;
  }

  .portada::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--portada-foto) center 30% / cover no-repeat var(--escenario-2);
    /* The only photo we have is 160px wide: blur it until the original arrives. */
    filter: blur(14px) saturate(0.9);
    transform: scale(1.08);
  }

  .portada::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--escenario) 35%, transparent) 0%,
      color-mix(in srgb, var(--escenario) 70%, transparent) 55%,
      var(--escenario) 100%
    );
  }

  .portada__contenido {
    max-width: 760px;
    margin-inline: auto 0;
    width: min(100% - 2 * var(--gutter), var(--contenedor));
  }

  .portada__nombre {
    margin: 0 0 clamp(16px, 3vw, 32px);
    font-stretch: var(--ancho-titulo);
    font-weight: 700;
    font-size: clamp(4rem, 14vw, 9rem);
    line-height: 0.88;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--tiza);
  }

  .portada h1 {
    font-size: var(--t-3);
    text-transform: none;
    letter-spacing: 0;
    line-height: 1.15;
    max-width: 30ch;
  }

  .portada .hero__lead {
    font-size: var(--t-1);
    max-width: 52ch;
  }

  .portada .hechos {
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 16px 36px;
    border-top-color: color-mix(in srgb, var(--tiza) 25%, transparent);
  }

  @media (max-width: 600px) {
    .portada .hechos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Photo tiles as the in-page menu. */
  .azulejos__grilla {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    max-width: none;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, 1fr);
  }

  @media (min-width: 720px) {
    .azulejos__grilla {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .azulejo {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radio);
    background: var(--escenario-2);
    color: var(--tiza);
    text-decoration: none;
    transition: transform 150ms ease;
  }

  .azulejo:hover {
    transform: translateY(-3px);
  }

  .azulejo:hover .azulejo__titulo {
    color: var(--laton);
  }

  .azulejo__foto {
    display: grid;
    place-content: center;
    padding: 16px;
    text-align: center;
    border: 1px dashed var(--escenario-linea);
    border-radius: var(--radio);
    color: var(--tiza-suave);
    font-size: 0.9rem;
  }

  .azulejo__titulo {
    position: absolute;
    inset: auto 0 0;
    padding: 14px 16px;
    background: linear-gradient(to top, color-mix(in srgb, var(--escenario) 92%, transparent), transparent);
    font-stretch: var(--ancho-titulo);
    font-weight: 700;
    font-size: var(--t-2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    transition: color 150ms ease;
  }

  .retrato {
    margin: 0;
  }

  .retrato :global(.pendiente--bloque) {
    aspect-ratio: auto;
    padding: 16px;
  }

  .ficha {
    max-width: none;
  }

  .ficha div + div {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--escenario-linea);
  }

  .ficha dt {
    font-stretch: var(--ancho-titulo);
    font-weight: 700;
    font-size: var(--t-2);
    text-transform: uppercase;
  }

  .ficha dd {
    margin: 4px 0 0;
    color: var(--tiza-suave);
  }

  .modos {
    display: grid;
    gap: 16px;
  }

  .modos > div:not(.pendiente) {
    padding: 20px;
    border-radius: var(--radio);
    background: var(--escenario-2);
  }

  .modos h3 {
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .modos p {
    margin: 0;
    color: var(--tiza-suave);
  }

  /* Anchor targets land below the section's top padding, not glued to the edge. */
  [id] {
    scroll-margin-top: 24px;
  }
</style>
