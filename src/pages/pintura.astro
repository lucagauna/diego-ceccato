---
/**
 * Main landing page: where the Google Business Profile and future ads point to.
 * The hero shows the WhatsApp conversation that is about to happen: the visitor's
 * pre-filled message and the one instruction Diego gives. Bubbles appear in turn.
 * Every sentence comes from Diego's form answers. Gaps are marked with <Pendiente>.
 */
import Base from "../layouts/Base.astro";
import BotonWhatsApp from "../components/BotonWhatsApp.astro";
import PinturaSecciones from "../components/PinturaSecciones.astro";
import { HORARIO, MENSAJES, listarZonas } from "../data/contacto";
import { negocioHogar } from "../data/schema";

const zonas = listarZonas("y");
---

<Base
  titulo="Pintor en Tigre y Zona Norte · Diego Ceccato"
  descripcion="Pintura de interiores, exteriores y frentes, hierro y madera en Tigre y Zona Norte. 30 años de oficio. Presupuesto por WhatsApp."
  seccion="pintura"
  datos={negocioHogar()}
  contacto="pintura"
>

  <section class="pedido">
    <div class="contenedor pedido__grilla">
      <div>
        <p class="ceja">01 · Látex azul</p>
        <h1>Pintura de casas en Tigre y Zona Norte</h1>
        <p class="hero__lead">Así de simple es pedir presupuesto. 30 años de oficio, trabajo solo: el que presupuesta hace el trabajo.</p>
        <BotonWhatsApp origen="pintura">Empezar el chat</BotonWhatsApp>
        <p class="suave pedido__nota">{zonas}.</p>
        <dl class="hechos">
          <div><dt>30 años</dt><dd>de oficio</dd></div>
          <div><dt>Trabajo solo</dt><dd>sin intermediarios</dd></div>
          <div><dt>{HORARIO}</dt><dd>horario de atención</dd></div>
          <div><dt>Por WhatsApp</dt><dd>mandá una foto y te paso presupuesto</dd></div>
        </dl>
      </div>

      <div class="chat" aria-label="Ejemplo de conversación">
        <p class="burbuja burbuja--vos" style="--i: 0">{MENSAJES.pintura}</p>
        <p class="burbuja burbuja--diego" style="--i: 1">Hola. Mandame una foto de lo que hay que pintar y te paso presupuesto.</p>
        <p class="burbuja burbuja--vos burbuja--foto" style="--i: 2"><span>📷 Foto</span></p>
        <p class="burbuja burbuja--diego" style="--i: 3">Listo, te paso presupuesto.</p>
      </div>
    </div>
  </section>

  <PinturaSecciones />
</Base>

<style>
  .pedido { padding-block: clamp(32px, 6vw, 72px) var(--seccion); border-bottom: 1px solid var(--linea); }

  .pedido__grilla { display: grid; gap: 32px 48px; align-items: center; }

  @media (min-width: 820px) {
    .pedido__grilla { grid-template-columns: 1.1fr 1fr; }
  }

  .ceja { margin: 0 0 12px; font-size: var(--t-0); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--azul); }
  .pedido h1 { font-size: var(--t-5); }
  .pedido__nota { margin: 16px 0 0; }

  .chat {
    display: grid;
    gap: 10px;
    padding: 20px;
    border-radius: 12px;
    background: var(--imprimacion);
    border: 1px solid var(--linea);
  }

  .burbuja {
    margin: 0;
    max-width: 85%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: var(--t-0);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(8px);
    animation: llegar 350ms ease forwards;
    animation-delay: calc(var(--i) * 600ms + 300ms);
  }

  @keyframes llegar { to { opacity: 1; transform: none; } }

  .burbuja--vos {
    justify-self: end;
    background: #d9f5e3;
    color: var(--tinta);
    border-bottom-right-radius: 4px;
  }

  .burbuja--diego {
    justify-self: start;
    background: var(--pared);
    color: var(--tinta);
    border: 1px solid var(--linea);
    border-bottom-left-radius: 4px;
  }

  .burbuja--foto span {
    display: grid;
    place-items: center;
    width: 140px;
    aspect-ratio: 4 / 3;
    border: 1px dashed var(--tinta-suave);
    border-radius: 8px;
    color: var(--tinta-suave);
  }

  @media (prefers-reduced-motion: reduce) {
    .burbuja { opacity: 1; transform: none; }
  }
</style>
