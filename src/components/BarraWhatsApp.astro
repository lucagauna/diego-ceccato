---
/**
 * Phone-only bar pinned to the bottom of the screen so the WhatsApp button is
 * always one tap away. Hidden from 720px up, where the hero button is visible anyway.
 */
import BotonWhatsApp from "./BotonWhatsApp.astro";
import type { Origen } from "../data/contacto";

interface Props {
  origen: Origen;
  etiqueta: string;
}

const { origen, etiqueta } = Astro.props;
---

<div class="barra" data-barra-whatsapp>
  <BotonWhatsApp origen={origen} class="barra__boton">{etiqueta}</BotonWhatsApp>
</div>

<style>
  .barra {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--pared) 92%, transparent);
    border-top: 1px solid var(--linea);
    backdrop-filter: blur(6px);
  }

  :global(.tema-oscuro) .barra {
    background: color-mix(in srgb, var(--escenario) 92%, transparent);
    border-top-color: var(--escenario-linea);
  }

  .barra :global(.barra__boton) {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 720px) {
    .barra {
      display: none;
    }
  }
</style>
