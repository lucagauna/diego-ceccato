---
/** Closing call to action shared by the service pages: WhatsApp first, a phone call as the alternative. */
import BotonWhatsApp from "./BotonWhatsApp.astro";
import { HORARIO, TELEFONO, linkTelefono } from "../data/contacto";
import type { Origen } from "../data/contacto";

interface Props {
  titulo: string;
  texto: string;
  origen: Origen;
}

const { titulo, texto, origen } = Astro.props;
---

<section class="seccion">
  <div class="contenedor cierre">
    <h2>{titulo}</h2>
    <p>{texto}</p>
    <p class="cierre__fila">
      <BotonWhatsApp origen={origen}>Escribime por WhatsApp</BotonWhatsApp>
      <span class="cierre__alt">o llamá al <a href={linkTelefono()}>{TELEFONO.visible}</a></span>
    </p>
    <p class="suave">{HORARIO}.</p>
  </div>
</section>

<style>
  .cierre h2 {
    font-size: var(--t-5);
  }

  .cierre__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin: 20px 0 8px;
  }

  .cierre__alt a {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
