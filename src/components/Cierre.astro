---
/** Closing call to action shared by the service pages. */
import BotonWhatsApp from "./BotonWhatsApp.astro";
import { HORARIO, TELEFONO } from "../data/contacto";
import type { Origen } from "../data/contacto";

interface Props {
  titulo: string;
  texto: string;
  origen: Origen;
}

const { titulo, texto, origen } = Astro.props;
---

<section class="seccion">
  <div class="contenedor cierre">
    <h2>{titulo}</h2>
    <p>{texto}</p>
    <p class="cierre__fila">
      <BotonWhatsApp origen={origen}>{TELEFONO.visible}</BotonWhatsApp>
      <span class="suave">{HORARIO}</span>
    </p>
  </div>
</section>

<style>
  .cierre h2 {
    font-size: var(--t-5);
  }

  .cierre__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 20px;
  }
</style>
