---
/**
 * The only contact control on the site.
 * `origen` picks the pre-filled message so Diego knows which page the chat came from.
 */
import { linkWhatsApp, type Origen } from "../data/contacto";

interface Props {
  origen: Origen;
  /** "lleno" is the main call to action; "texto" is an inline link with the icon. */
  variante?: "lleno" | "texto";
  class?: string;
}

const { origen, variante = "lleno", class: extra = "" } = Astro.props;
---

<a
  href={linkWhatsApp(origen)}
  class:list={["wa", `wa--${variante}`, extra]}
  target="_blank"
  rel="noopener"
>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.24-9.43 9.44-9.43a9.4 9.4 0 0 1 9.43 9.44c0 5.2-4.23 9.42-9.44 9.42zm8.03-17.46A11.27 11.27 0 0 0 12.05.72C5.8.72.7 5.8.7 12.07c0 2 .52 3.95 1.52 5.67L.6 23.6l6-1.57a11.3 11.3 0 0 0 5.43 1.38h.01c6.25 0 11.34-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02z"
    />
  </svg>
  <slot />
</a>

<style>
  .wa {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease, transform 150ms ease;
  }

  .wa--lleno:active {
    transform: translateY(1px);
  }

  .wa--lleno {
    min-height: 52px;
    padding: 12px 22px;
    border-radius: var(--radio);
    background: var(--wa);
    color: #fff;
    font-size: var(--t-1);
  }

  .wa--lleno:hover,
  .wa--lleno:active {
    background: var(--wa-hover);
  }

  .wa--texto {
    color: var(--wa);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  :global(.tema-oscuro) .wa--texto {
    color: #4cc77a;
  }
</style>
